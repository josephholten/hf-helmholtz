border b1(t=0, 2*pi){ x=cos(t); y=sin(t); label=1; }
real k = 10;
real hmax = .5/k, l2erau, l2erav;
int  nborder = 2*pi / hmax;
mesh Th = buildmesh(b1(nborder)), Th4 = trunc(Th, 1, split=4);

fespace Vh(Th, P1), Vh4(Th4, P1);

func u = exp(1i*k*x);
func dxu = 1i*k*exp(1i*k*x);
func dyu = 0.;

Vh<complex> uh, vh, wh;
Vh4<complex> uh4, vh4;

func g = (1i*k*(x-1)*exp(1i*k*x));

solve Helmholtz (uh,vh) =
  int2d(Th)(k^(-2)*(dx(uh)*conj(dx(vh))+dy(uh)*conj(dy(vh))) - uh*conj(vh))
  - int1d(Th,1)(1i*k^(-1)*uh*conj(vh))
  - int1d(Th,1)(k^(-2)*g*conj(vh));

solve Helmholtz2 (vh,wh) =
  int2d(Th)(k^(-2)*(dx(vh)*conj(dx(wh))+dy(vh)*conj(dy(wh)))+vh*conj(wh))
  - int2d(Th)(k^(-2)*(dxu*conj(dx(wh))+dyu*conj(dy(wh))))
  - int2d(Th)(u*conj(wh));

l2erau = sqrt(int2d(Th)(abs(u-uh)^2)+int2d(Th)(k^(-2)*(abs(dxu-dx(uh))^2+abs(dyu-dy(uh))^2)));
l2erav = sqrt(int2d(Th)(abs(u-vh)^2)+int2d(Th)(k^(-2)*(abs(dxu-dx(vh))^2+abs(dyu-dy(vh))^2)));

cout << endl;
cout << "-----------------" << endl;
cout << "l2erau = " << l2erau << endl;
cout << "l2erav = " << l2erav << endl;
cout << "-----------------" << endl;
cout << endl;

