border b1(t=0, 2*pi){ x=cos(t); y=sin(t); label=1; }
real hmax = .01;
real k = 10;
int  nborder = 2*pi / hmax;
mesh Th = buildmesh(b1(nborder));

fespace Vh(Th, P1);

func u = exp(1i*k*x);

Vh<complex> uh, vh, uht = u, wh;

func g = (1i*k*(x-1)*exp(1i*k*x));

solve Helmholtz (uh,vh) =
  int2d(Th)(k^(-2)*(dx(uh)*conj(dx(vh))+dy(uh)*conj(dy(vh))) - uh*conj(vh))
  - int1d(Th,1)(1i*k^(-1)*uh*conj(vh))
  - int1d(Th,1)(k^(-2)*g*conj(vh));

solve Helmholtz2 (vh,wh) =
  int2d(Th)(k^(-2)*(dx(vh)*conj(dx(wh))+dy(vh)*conj(dy(wh)))+vh*conj(wh))
  - int2d(Th)(k^(-2)*(dx(uht)*conj(dx(wh))+dy(uht)*conj(dy(wh))))
  - int2d(Th)(uht*conj(wh));

real l2era1 = sqrt(int2d(Th)(abs(u-uh)^2));
real l2era2 = sqrt(int2d(Th)(abs(u-vh)^2));

cout << endl;
cout << "-----------------" << endl;
cout << "l2era1 = " << l2era1 << endl;
cout << "l2era2 = " << l2era2 << endl;
cout << "-----------------" << endl;
cout << endl;

Vh Ruh = real(uh);
Vh Rvh = real(vh);
plot(Ruh, fill=true, value=true, wait=true, cmm="Ruh - Helmholtz 1");