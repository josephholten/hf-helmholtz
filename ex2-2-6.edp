border b1(t=0, 2*pi){ x=cos(t); y=sin(t); label=1; }
real hmax = .01;
real k = 10;
int  nborder = 2*pi / hmax;
mesh Th = buildmesh(b1(nborder));

fespace Vh(Th, P1);

Vh<complex> uh, vh;

func g = (1i*k*(x-1)*exp(1i*k*x));

solve Helmholtz (uh,vh) =
  int2d(Th)(k^(-2)*(dx(uh)*conj(dx(vh))+dy(uh)*conj(dy(vh))) - uh*conj(vh))
  - int1d(Th,1)(1i*k^(-1)*uh*conj(vh))
  - int1d(Th,1)(k^(-2)*g*conj(vh));

func u = exp(1i*k*x);
real l2era = sqrt(int2d(Th)(abs(uh-u)^2));
real l2err = sqrt(int2d(Th)(abs(uh-u)^2) / int2d(Th)(abs(u)^2));
cout << "l2era = " << l2era << endl;
cout << "l2err = " << l2err << endl;

Vh<complex> uht = u;
solve Helmholtz2 (vh,wh) = int2d(Th)(k^(-2)*((dx(vh)-dx(uht))*conj(dx(wh)) + (dy(vh)-dy(uht))*conj(dy(wh))) + (vh-uht)*conj(wh));

//Vh Ruh = real(uh);
//plot(Ruh, fill=true, value=true);

Vh Rvh = real(vh);
plot(Rvh, fill=true, value=true);