load "qf11to25"

border b1(t=0, 2*pi){ x=cos(t); y=sin(t); label=1; }
ofstream f("ratio2.dat");

macro H1kerr(wh) sqrt(
  int2d(Th4, qforder=12)(abs(u-wh)^2)
  + int2d(Th4, qforder=12)(k^(-2)*(abs(dxu-dx(wh))^2+abs(dyu-dy(wh))^2))
) //

int p = 2;
real c0 = 1.5;
real c1 = 8;

for (int ik = 0; ik < 6; ik++) {
  real k = 10 + 5*ik;
  func u = exp(1i*k*x);
  func dxu = 1i*k*exp(1i*k*x);
  func dyu = 0.;
  func g = 1i*k*(x-1)*exp(1i*k*x);

  f << k << " ";
  cout << "k=" << k << endl;

  for (int ir = 0; ir < 2; ir++) {
    cout << "ir=" << ir << endl;
    real hmax;
    if (ir == 0) hmax = c0 * k^(-1);
    if (ir == 1) hmax = c1 * k^(-1.5);
    int nborder = 2*pi / hmax;
    mesh Th = buildmesh(b1(nborder)), Th4 = trunc(Th, 1, split=4);

    fespace Vh(Th, P2), Vh4(Th4, P2);
    Vh<complex> uh, vh, wh;
    Vh4<complex> uh4, vh4;

    solve Helmholtz (uh,vh) =
      int2d(Th, qforder=12)(k^(-2)*(dx(uh)*conj(dx(vh))+dy(uh)*conj(dy(vh))) - uh*conj(vh))
      - int1d(Th,1, qforder=12)(1i*k^(-1)*uh*conj(vh))
      - int1d(Th,1, qforder=12)(k^(-2)*g*conj(vh));

    solve Helmholtz2 (vh,wh) =
      int2d(Th, qforder=12)(k^(-2)*(dx(vh)*conj(dx(wh))+dy(vh)*conj(dy(wh)))+vh*conj(wh))
      - int2d(Th, qforder=12)(k^(-2)*(dxu*conj(dx(wh))+dyu*conj(dy(wh))))
      - int2d(Th, qforder=12)(u*conj(wh));

    uh4 = uh; vh4 = vh;

    f << H1kerr(uh4)/H1kerr(vh4) << " ";
    cout << "ratio=" << H1kerr(uh4)/H1kerr(vh4) << endl;
  }

  f << endl;
}