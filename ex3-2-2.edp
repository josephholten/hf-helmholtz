load "Element_P3"

real a=0.5;
real L=1;

border b1(t=0,2*L+a){ x=t;       y=0;   label=1; }
border b2(t=0,L){     x=2*L+a;   y=t;   label=1; }
border b3(t=0,2*L+a){ x=2*L+a-t; y=L;   label=1; }
border b4(t=0,L){     x=0;       y=L-t; label=1; }

macro H1kerr(wh) sqrt(
  int2d(Th)(abs(u-wh)^2)
  + int2d(Th)(k^(-2)*(abs(dxu-dx(wh))^2+abs(dyu-dy(wh))^2))
) //

real k = 10;
func u = exp(1i*k*x);
func dxu = 1i*k*exp(1i*k*x);
func dyu = 0.;
func g = 1i*(N.x-1)*exp(1i*k*x);

real hmax = .5/k; real hmin = hmax/4;
int nborder1 = (2*L+a) / hmax;
int nborder2 =    L   / hmax;
mesh Th = buildmesh(b1(nborder1) + b2(nborder2) + b3(nborder1) + b4(nborder2));
func mref = (x < L-a/2) * 1
          + (x >= L-a/2 && x < L+a/2) * (0.5*sin(-pi/2*(x-L)/a) + 0.5);
Th = adaptmesh(Th, hmax*mref+hmin, IsMetric=1, nbvx=1e7);
plot(Th, wait=true, cmm="adapted mesh");

fespace Vh(Th, P3);
Vh<complex> uh, vh;

solve Helmholtz (uh,vh) =
  int2d(Th)(k^(-2)*(dx(uh)*conj(dx(vh))+dy(uh)*conj(dy(vh))) - uh*conj(vh))
  - int1d(Th,1)(1i*k^(-1)*uh*conj(vh))
  - int1d(Th,1)(k^(-1)*g*conj(vh));

cout << "err=" << H1kerr(uh) << endl;

Vh Ruh = real(uh), era = log(10^(-12)+abs(real(uh-u)))/log(10.);
plot(Ruh, fill=true, cmm="real part of uh", wait=true);
plot(era, fill=true, cmm="log10 era", wait=true);