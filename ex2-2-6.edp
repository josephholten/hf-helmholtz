border b1(t=0, 2*pi){ x=cos(t); y=sin(t); label=1; }
ofstream f("ratio.dat");

macro H1kerr(wh) sqrt(
  int2d(Th)(abs(u-wh)^2)
  + int2d(Th)(k^(-2)*(abs(dxu-dx(wh))^2+abs(dyu-dy(wh))^2))
) //

for (int ik = 0; ik < 6; ik++) {
  real k = 10 + 5*ik;
  func u = exp(1i*k*x);
  func dxu = 1i*k*exp(1i*k*x);
  func dyu = 0.;
  func g = 1i*k*(x-1)*exp(1i*k*x);

  f << k << " ";
  cout << "k=" << k << endl;

  for (int ir = 0; ir < 2; ir++) {
    cout << "ir=" << ir << endl;
    real hmax = 5*10.^(ir-1)*k^(-ir-1);
    int nborder = 2*pi / hmax;
    mesh Th = buildmesh(b1(nborder));

    fespace Vh(Th, P1);
    Vh<complex> uh, vh, wh;

    solve Helmholtz (uh,vh) =
      int2d(Th)(k^(-2)*(dx(uh)*conj(dx(vh))+dy(uh)*conj(dy(vh))) - uh*conj(vh))
      - int1d(Th,1)(1i*k^(-1)*uh*conj(vh))
      - int1d(Th,1)(k^(-2)*g*conj(vh));

    solve Helmholtz2 (vh,wh) =
      int2d(Th)(k^(-2)*(dx(vh)*conj(dx(wh))+dy(vh)*conj(dy(wh)))+vh*conj(wh))
      - int2d(Th)(k^(-2)*(dxu*conj(dx(wh))+dyu*conj(dy(wh))))
      - int2d(Th)(u*conj(wh));

    f << H1kerr(uh)/H1kerr(vh) << " ";
  }

  f << endl;
}